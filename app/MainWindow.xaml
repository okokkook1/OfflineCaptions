<Window x:Class="OfflineCaptions.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="離線即時字幕" Width="1060" Height="820" MinWidth="880" MinHeight="680" Background="#F3F5F4" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#172F39" Padding="30,24"><Grid><StackPanel><TextBlock Text="聽見每一句，讀懂每一刻。" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="離線即時字幕  /  中文・English → 繁體中文" Foreground="#B5C8CE" Margin="0,8,0,0" FontSize="13"/></StackPanel><Border Background="#304C53" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="●  本機處理" Foreground="#AEE0CB" FontSize="12"/></Border></Grid></Border>
    <Grid Grid.Row="1" Margin="26,22,26,16"><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="01  選擇聲音來源" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <Border Background="White" CornerRadius="12" Padding="20"><StackPanel>
          <TextBlock Text="收音範圍" Style="{StaticResource Label}"/>
          <ComboBox x:Name="CaptureMode" SelectedIndex="0" SelectionChanged="CaptureModeChanged"><ComboBoxItem Content="指定應用程式"/><ComboBoxItem Content="整個播放裝置（所有聲音）"/></ComboBox>
          <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SourceLabel" Text="應用程式" Style="{StaticResource Label}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="重新整理" Click="RefreshClick" Padding="9,5" Margin="0,0,0,6" FontSize="11"/></Grid>
          <ComboBox x:Name="Sources" MinHeight="42"><ComboBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="20" Height="20"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontSize="12"/><ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="100" Height="3" Width="210" HorizontalAlignment="Left" Margin="0,4,0,0" Foreground="#3F8C79"/></StackPanel></Grid></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <ComboBox x:Name="Devices" DisplayMemberPath="Name" Visibility="Collapsed" MinHeight="42"/>
          <TextBlock Text="先讓來源播放聲音，再按重新整理。瀏覽器可能包含其他分頁的聲音。" FontSize="11" Foreground="#687B83" Margin="0,10,0,0"/>
          <Separator Margin="0,16" Background="#E7ECEB"/>
          <TextBlock Text="說話語言" Style="{StaticResource Label}"/>
          <ComboBox x:Name="LanguagePicker" SelectedIndex="0"><ComboBoxItem Content="自動辨識中英" Tag="auto"/><ComboBoxItem Content="英文" Tag="en"/><ComboBoxItem Content="中文普通話" Tag="zh"/></ComboBox>
          <TextBlock Text="辨識模型" Style="{StaticResource Label}" Margin="0,14,0,8"/>
          <Border Background="#EEF4EF" CornerRadius="6" Padding="10,9"><StackPanel><TextBlock Text="SenseVoice Small INT8" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="CPU 離線辨識 · 每秒更新暫定字幕" FontSize="11" Foreground="#526A62" Margin="0,4,0,0"/></StackPanel></Border>
          <WrapPanel Margin="0,18,0,0"><Button x:Name="StartButton" Content="▶  開始字幕" Background="#226A5B" Foreground="White" Click="StartClick"/><Button x:Name="PauseButton" Content="暫停" IsEnabled="False" Click="PauseClick"/><Button x:Name="StopButton" Content="結束" IsEnabled="False" Click="StopClick" Margin="0"/></WrapPanel>
        </StackPanel></Border>
        <TextBlock Text="02  字幕外觀" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,14"/>
        <Border Background="White" CornerRadius="12" Padding="20"><StackPanel>
          <TextBlock Text="顯示螢幕" Style="{StaticResource Label}"/><ComboBox x:Name="Screens" SelectionChanged="ScreenChanged"/>
          <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="字體大小" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="FontSlider" Grid.Column="1" Minimum="18" Maximum="52" Value="28" ValueChanged="AppearanceChanged"/></Grid>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="背景濃度" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.2" Maximum="1" Value="0.8" ValueChanged="AppearanceChanged"/></Grid>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="字幕寬度" VerticalAlignment="Center" FontSize="12"/><Slider x:Name="WidthSlider" Grid.Column="1" Minimum="460" Maximum="1400" Value="900" ValueChanged="AppearanceChanged"/></Grid>
          <WrapPanel Margin="0,16,0,0"><Button Content="預覽字幕" Click="PreviewClick" Padding="12,7"/><Button x:Name="MouseButton" Content="滑鼠穿透" Click="MouseClick" Padding="12,7"/></WrapPanel>
          <TextBlock x:Name="HotkeyHint" Text="Ctrl+Alt+S：切換穿透  ·  Ctrl+Alt+H：顯示 / 隱藏" FontSize="10" Foreground="#687B83" Margin="0,10,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#E4EDE7" CornerRadius="12" Padding="18,15"><StackPanel><TextBlock x:Name="Status" Text="準備就緒" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="Detail" Text="選擇來源後開始。音訊與文字只在這台電腦處理。" Foreground="#526A62" FontSize="12" Margin="0,7,0,0"/><TextBlock x:Name="Metrics" Text="收音 —　處理延遲 —" Foreground="#526A62" FontSize="11" Margin="0,8,0,0"/><ProgressBar x:Name="InputLevel" Height="4" Maximum="100" Margin="0,10,0,0" Foreground="#3F8C79"/></StackPanel></Border>
        <Expander Grid.Row="1" Header="模型管理與效能測試" Margin="0,16,0,16"><Border Background="White" CornerRadius="8" Padding="14"><StackPanel>
          <TextBlock Text="首次下載需連線；完成後可斷網使用。匯入 / 匯出模型包可讓另一台電腦離線安裝。" FontSize="11" Foreground="#687B83"/>
          <WrapPanel Margin="0,12,0,0"><Button Content="下載模型" Click="DownloadClick" Padding="10,7"/><Button Content="匯入模型" Click="ImportClick" Padding="10,7"/><Button Content="匯出模型包" Click="ExportModelsClick" Padding="10,7"/></WrapPanel>
          <WrapPanel Margin="0,10,0,0"><Button Content="10 秒效能測試" Click="BenchmarkClick" Padding="10,7"/><TextBlock x:Name="ModelStatus" Text="SenseVoice Small INT8" VerticalAlignment="Center" FontSize="11" Foreground="#687B83"/></WrapPanel>
        </StackPanel></Border></Expander>
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="本次字幕" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Text="0 段" HorizontalAlignment="Right" Foreground="#687B83" FontSize="12"/></Grid>
          <TextBlock Grid.Row="1" Text="完成字幕才會加入紀錄。未匯出的內容將於關閉時清除。" FontSize="11" Foreground="#687B83" Margin="0,8,0,12"/>
          <ListBox x:Name="History" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#EAF0EC" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><TextBlock Text="{Binding Time}" FontSize="10" Foreground="#879991"/><TextBlock Text="{Binding Text}" FontSize="15" Margin="0,5,0,0"/><TextBlock Text="{Binding Original}" FontSize="11" Foreground="#7A878C" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="匯出 TXT" Click="ExportTxtClick"/><Button Content="匯出 SRT" Click="ExportSrtClick"/></StackPanel>
        </Grid></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#E9EEEB" Padding="28,10"><TextBlock Text="音訊不錄存 · 不擷取麥克風 · 字幕僅顯示於你的螢幕 · 完全離線推論" FontSize="11" Foreground="#64776D"/></Border>
  </Grid>
</Window>
